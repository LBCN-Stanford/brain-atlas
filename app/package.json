{
  "name": "intracranial-stimulation-atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/strip-controlled.mjs && node scripts/prune-dist.mjs && node scripts/notices.mjs && node scripts/finalize-dist.mjs",
    "build:controlled": "tsc -b && vite build && BUILD_INCLUDE_CONTROLLED=1 node scripts/strip-controlled.mjs && node scripts/prune-dist.mjs && node scripts/notices.mjs && node scripts/finalize-dist.mjs",
    "test": "tsx --tsconfig tsconfig.app.json --test \"scripts/*.test.ts\"",
    "test:e2e": "node scripts/atlas_e2e.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
