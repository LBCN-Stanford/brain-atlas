    "@fontsource/source-serif-4": "^5.3.0",
    "@niivue/niivue": "^0.69.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "nifti-reader-js": "^0.8.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.9.0",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
